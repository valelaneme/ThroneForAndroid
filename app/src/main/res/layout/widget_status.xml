<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:padding="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 左侧：上一节点 -->
        <ImageButton
            android:id="@+id/widget_previous"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/widget_button_background"
            android:contentDescription="@string/widget_previous"
            android:src="@drawable/ic_widget_previous" />

        <!-- 中间容器：不再作为一个整体按钮 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <!-- 开关按钮：单独保留点击事件（控制 VPN 开关） -->
            <ImageView
                android:id="@+id/widget_toggle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/widget_button_background"
                android:contentDescription="@string/widget_toggle"
                android:padding="4dp"
                android:src="@drawable/ic_widget_off" />

            <!-- 文字区域：新增独立 ID，用于点击弹出切换窗口 -->
            <LinearLayout
                android:id="@+id/widget_switch_menu"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/widget_button_background"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/app_name"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/widget_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_stopped"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 右侧：下一节点 -->
        <ImageButton
            android:id="@+id/widget_next"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/widget_button_background"
            android:contentDescription="@string/widget_next"
            android:src="@drawable/ic_widget_next" />
    </LinearLayout>
</FrameLayout>
